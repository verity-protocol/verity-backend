# =============================================================================
# Verity Backend — Environment Variables
# Copy this file to .env and fill in the values.
# =============================================================================

# App
NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=verity

# Stellar
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_PASSPHRASE="Test SDF Future Network ; October 2022"

# DID Registry contract (C... address of the deployed did_registry contract)
# Copy this from the deploy step in scripts/e2e-local-setup.sh.
STELLAR_CONTRACT_DID_REGISTRY=

# Fee sponsor keypair (G.../S...). Signs the outer envelope and pays fees for
# DID create/link/unlink confirms. Requires no on-chain privilege itself.
# This is the LOW-PRIVILEGE signing key.
STELLAR_FEE_SPONSOR_SECRET=

# Admin keypair (G.../S...). Sole signer for set_verified calls against the
# did_registry contract. IMPORTANT: the public key MUST equal the `admin` the
# registry was deployed with (see --constructor-args in e2e-local-setup.sh),
# otherwise verification writes will be rejected on chain.
# This is the HIGH-PRIVILEGE signing key; store it securely.
STELLAR_ADMIN_SECRET=

# Credential Registry contract (C... address of the deployed credential contract)
STELLAR_CONTRACT_CREDENTIAL_REGISTRY=

# Issuer keypair (G.../S...). Signs issue_credential and revoke_credential calls
# against the credential contract. The public key MUST be an approved issuer in
# the issuer_registry contract, otherwise issuance is rejected on chain.
# This is the MEDIUM-PRIVILEGE signing key; store it securely.
STELLAR_ISSUER_SECRET=

# KYC Provider (external service)
KYC_PROVIDER_API_URL=https://api.example.com
KYC_PROVIDER_API_KEY=your-api-key-here

# CORS
CORS_ORIGIN=*

# OAuth Session
SESSION_EXPIRY_MINUTES=5
